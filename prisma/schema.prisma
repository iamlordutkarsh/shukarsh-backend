generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// How the customer pays. COD money arrives with the courier days after
/// dispatch, so paymentStatus stays PENDING on a perfectly good order and
/// nothing may read PENDING as "abandoned" without checking this first.
enum PaymentMethod {
  PREPAID
  COD
}

/// Why a parcel is coming back. Only faults on our side are accepted: nails and
/// kitchen goods cannot be resold once opened, so change of mind is not offered.
enum ReturnReason {
  DAMAGED
  WRONG_ITEM
}

/// What the customer asked us to do about it.
enum ReturnOutcome {
  REFUND
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// The goods are back with us and have been looked at.
  RECEIVED
  /// Refunded or replaced; nothing further is owed.
  COMPLETED
  /// Withdrawn by the customer before we decided.
  WITHDRAWN
}

enum CouponType {
  PERCENT
  FLAT
  FREE_SHIPPING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  wishlist    WishlistItem[]
  redemptions CouponRedemption[]
  returns     ReturnRequest[]
  stockMoves  StockMove[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String?
  country   String   @default("US")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  image       String?
  /// Order among its siblings. A menu is not alphabetical: "Men Top Wear" comes
  /// before "Men Inner & Sleepwear" because that is the order the shop sells in.
  position    Int              @default(0)
  parentId    String?
  parent      Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]       @relation("CategoryHierarchy")
  products    Product[]
  coupons     CouponCategory[]
  attributes  AttributeDefinition[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([parentId])
}

/// What kind of answer an attribute takes.
enum AttributeKind {
  /// One of a fixed list. The common case: fabric, neck, sleeve length.
  SELECT
  /// Any number of a fixed list, for something like "occasion".
  MULTISELECT
  /// Free text, for the handful of things no list can cover.
  TEXT
  /// A quantity, with `unit` saying what of.
  NUMBER
}

/// One question a category asks about its products.
///
/// Owned by a category and **inherited by everything under it**, which is what
/// makes the tree worth having: "Country of origin" is asked once at the root,
/// "Sleeve length" only under Tshirts, and picking a category is what decides the
/// form. A key defined again lower down overrides the one above it, so a branch
/// can narrow a general question without the root having to know.
///
/// Separate from Product.specs, which stays as the escape hatch for a one-off
/// fact that does not deserve a definition across a whole category.
model AttributeDefinition {
  id         String        @id @default(uuid())
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Stable and machine-readable, because it ends up in a filter query string.
  /// Renaming the label must not break a link somebody bookmarked.
  key        String
  /// What the admin and the shopper read: "Sleeve Length".
  label      String
  kind       AttributeKind @default(SELECT)
  /// What a NUMBER is counted in: "gsm", "ml". Null for every other kind.
  unit       String?
  /// A product in this category cannot be saved without answering it.
  required   Boolean       @default(false)
  /// Offered as a facet on the catalogue. Only ever true for SELECT and
  /// MULTISELECT: nobody filters a shop by free text.
  filterable Boolean       @default(false)
  position   Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  options AttributeOption[]
  values  ProductAttribute[]

  /// One question per key per category. The same key on a child is the override.
  @@unique([categoryId, key])
  @@index([categoryId])
}

/// One allowed answer to a SELECT or MULTISELECT question.
///
/// A fixed list rather than free text is the whole point: "Cotton", "100% cotton"
/// and "cotton blend" typed into three products are three values nothing can
/// filter on, and that is what a spec table of free text degrades into.
model AttributeOption {
  id           String              @id @default(uuid())
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())

  values ProductAttribute[]

  @@unique([definitionId, value])
  @@index([definitionId])
}

/// What one product answered.
///
/// Which column holds it depends on the definition's kind, and exactly one of
/// them is ever set. A MULTISELECT is several rows against one definition, which
/// is why the option is part of the key rather than the definition alone.
model ProductAttribute {
  id           String              @id @default(uuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /// Set for SELECT and MULTISELECT.
  optionId     String?
  option       AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// Set for TEXT.
  valueText    String?
  /// Set for NUMBER.
  valueNumber  Decimal?            @db.Decimal(12, 3)
  createdAt    DateTime            @default(now())

  /// Binds on the picked kinds. It cannot bind for TEXT or NUMBER, where optionId
  /// is null and Postgres counts two nulls as different, so the write path is
  /// what stops a product answering the same question twice.
  @@unique([productId, definitionId, optionId])
  @@index([productId])
  /// The faceted read: every product whose answer to this question is that option.
  @@index([definitionId, optionId])
}

model Product {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String?
  price             Decimal  @db.Decimal(10, 2)
  comparePrice      Decimal? @db.Decimal(10, 2)
  stock             Int      @default(0)
  /// Stock at or below this counts as needing a reorder. Per product because a
  /// set of plates and a packet of nails do not sell at the same rate.
  lowStockThreshold Int      @default(5)
  images            String[]
  isActive          Boolean  @default(true)
  weightKg          Decimal  @default(0.5) @db.Decimal(6, 3)
  lengthCm          Int      @default(15)
  breadthCm         Int      @default(12)
  heightCm          Int      @default(6)
  hsn               String?
  /// The spec table under the product: `[{ label, value }]`, in the order the
  /// shop typed them. JSON rather than a table because nothing queries it and
  /// the catalogue list already carries two joins; a third, for rows only ever
  /// read whole and only ever on one page, buys nothing.
  specs             Json?
  /// The long copy, as blocks: `[{ kind: "text" | "highlights" | "faq", ... }]`.
  /// Same reasoning as specs. Validated on the way in by detailBlockSchema, so
  /// what a page renders is a shape the API agreed to and not whatever was in
  /// the column.
  details           Json?
  /// GST percent. Price is the MRP, so this says how much tax is already inside it.
  gstRate           Decimal  @default(5) @db.Decimal(5, 2)
  /// What this costs to buy in, net of GST, since input tax credit means the
  /// tax paid to a supplier is not really a cost. Never leaves the API to
  /// anyone but an admin: see serializeProduct.
  costPrice         Decimal? @db.Decimal(10, 2)
  /// Where it was made. Required on the label of anything packaged and sold
  /// online in India, so it is a column rather than an attribute: a category
  /// nobody defined it on would silently drop a legal requirement.
  countryOfOrigin   String?
  /// Who packed it, and where. The Legal Metrology (Packaged Commodities) Rules
  /// want a name and an address a customer can actually write to, which is why
  /// the pincode is kept apart from the rest of the address rather than trusted
  /// to be somewhere inside it.
  manufacturerName  String?
  manufacturerAddr  String?
  manufacturerPin   String?
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attributes ProductAttribute[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlisted WishlistItem[]
  coupons    CouponProduct[]
  stockMoves StockMove[]
  variants   ProductVariant[]
  colours    ProductColour[]
}

/// One colour a product comes in.
///
/// Its own row rather than a column on the variant because a colour carries
/// photos, and a red shirt in five sizes is one set of photos, not five copies of
/// it. Storing them on the variant would mean uploading the same image five times
/// and hoping nobody edits one of them.
///
/// Optional like sizes: a product with no colours sells exactly as it did.
model ProductColour {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// What the customer reads on the swatch: "Midnight blue".
  name      String
  /// What the swatch is painted, as `#rrggbb`. Null falls back to a neutral chip
  /// with the name in it, because a colour nobody can name in hex is still a
  /// colour worth selling.
  hex       String?
  /// The second half of a two-tone swatch, for a print, a stripe or anything
  /// else no single colour describes. Null is the ordinary case and draws a
  /// plain circle; set, and the swatch is split between the two.
  hex2      String?
  /// This colour's own photos. Empty falls back to the product's, so a shop that
  /// only has one set of pictures is not forced to upload them per colour.
  images    String[] @default([])
  /// Order in the swatch row, because a palette is not alphabetical.
  position  Int      @default(0)
  /// Off keeps the history and stops the sales, exactly as on a size.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@unique([productId, name])
  @@index([productId])
}

/// The shop's own list of colours, reused across products.
///
/// Exists because ProductColour.name is free text, and free text drifts: one
/// product says "Navy", the next "navy blue", the third "Dark Blue", and they are
/// three colours with three sets of photos that no filter can ever bring
/// together. Picking from a list at the point of typing is what stops that.
///
/// Deliberately not a foreign key from ProductColour. A product's colour still
/// owns its own name, hex and photos, so retiring a preset cannot repaint
/// products already using it, and a one-off colour that never joins the palette
/// is still possible. The palette guides the typing; it does not own the result.
model ColourPreset {
  id        String   @id @default(uuid())
  name      String   @unique
  hex       String?
  /// The second half of a two-tone swatch, as on ProductColour.
  hex2      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One buyable cell of a product: a colour, a size, or the pairing of the two.
///
/// Optional by design: a frying pan has neither and must keep working exactly as
/// it did, so a product with no variants sells from Product.stock as before. Where
/// variants exist they own the stock instead, and Product.stock is kept as their
/// sum so the catalogue badge, the sorting and the reorder digest need no special
/// case.
///
/// Both axes are optional independently, so all four shapes are one model:
/// sizes only (colourId null), colours only (label ""), the full matrix, and
/// neither. A shelf is a shelf whichever of the two named it.
model ProductVariant {
  id        String         @id @default(uuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Which colour this cell belongs to. Null on a product sold in sizes only.
  colourId  String?
  colour    ProductColour? @relation(fields: [colourId], references: [id], onDelete: Cascade)
  /// The size the customer picks: "M", "38". Empty string on a product sold by
  /// colour alone, rather than null, so the pair below reads as one key and a
  /// colour-only product cannot hold two nameless rows.
  label     String
  /// What this cell costs, when it differs from the product. Null is the normal
  /// case and means the product's own price: an XXL that costs more is a decision
  /// the shop makes deliberately, and every quote resolves this the same way in
  /// priceCart so nothing downstream has to guess which row holds the money.
  price     Decimal?       @db.Decimal(10, 2)
  /// Order in the picker, because S/M/L/XL is not alphabetical.
  position  Int            @default(0)
  stock     Int            @default(0)
  /// Off keeps the history and stops the sales. A combination that is
  /// discontinued, or never existed, still has to print on the orders that
  /// bought it.
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  stockMoves StockMove[]
  orderItems OrderItem[]

  /// Binds on a product that has colours. It cannot bind when colourId is null,
  /// because Postgres counts two nulls as different values, so the colourless
  /// case is guarded in the variants handler instead — which compares labels
  /// case-insensitively and so refuses "M" beside "m" as well.
  @@unique([productId, colourId, label])
  @@index([productId])
  @@index([colourId])
}

/// Why the number on the shelf changed.
enum StockMoveReason {
  /// Opening quantity, set when the product was added.
  INITIAL
  /// A paid order took units.
  SALE
  /// An order was called off and its units came back.
  CANCELLATION
  /// A cancelled order was reopened and took its units again.
  REOPEN
  /// A returned parcel was judged sellable again.
  RETURN_RESTOCK
  /// New stock arrived.
  RECEIVED
  /// Counted the shelf and the number was wrong.
  CORRECTION
  /// Broken, lost or written off.
  DAMAGE
}

/// One movement of stock, and why.
///
/// Product.stock stays the truth: the conditional decrement on it is what stops
/// two customers being sold the same last dress, and summing this table on every
/// read would be slower and racier. This is the record beside it, so a number
/// nobody expects can be explained instead of argued about.
model StockMove {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Which size moved, when the product has sizes. Null is a product that has
  /// none, so the ledger reads the same for both.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Signed. Positive puts units on the shelf, negative takes them off.
  delta     Int
  /// What the shelf held once this had been applied, so history reads without
  /// re-summing everything before it, and a drift check has something to compare.
  balance   Int
  reason    StockMoveReason
  /// Free text from whoever adjusted it by hand.
  note      String?
  /// Null when nobody did it: a payment landing or a courier scan moves stock
  /// with no admin in the room.
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([variantId])
}

/// Small key/value bookkeeping the shop needs and nothing else owns.
///
/// Exists so "have we already done this today" survives a restart. A free host
/// redeploys and sleeps often, and without somewhere durable to write it, a daily
/// email becomes an email every time the process comes up.
model SystemFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Order {
  id                String            @id @default(uuid())
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  email             String?
  customerName      String?
  customerPhone     String?
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  paymentMethod     PaymentMethod     @default(PREPAID)
  itemsTotal        Decimal           @default(0) @db.Decimal(10, 2)
  shippingAmount    Decimal           @default(0) @db.Decimal(10, 2)
  /// What the courier charges to collect cash, passed on to the customer. Zero
  /// on a prepaid order.
  codFee            Decimal           @default(0) @db.Decimal(10, 2)
  /// totalAmount is itemsTotal - discountTotal + shippingAmount + codFee.
  discountTotal     Decimal           @default(0) @db.Decimal(10, 2)
  couponId          String?
  coupon            Coupon?           @relation(fields: [couponId], references: [id])
  /// Snapshot, so a renamed or deleted code still reads correctly on the order.
  couponCode        String?
  totalAmount       Decimal           @db.Decimal(10, 2)
  /// GST already inside totalAmount, broken out for the invoice. Prices are
  /// tax-inclusive, so these never add to what the customer was charged.
  taxTotal          Decimal           @default(0) @db.Decimal(10, 2)
  cgstTotal         Decimal           @default(0) @db.Decimal(10, 2)
  sgstTotal         Decimal           @default(0) @db.Decimal(10, 2)
  igstTotal         Decimal           @default(0) @db.Decimal(10, 2)
  /// Buyer's state at the time of the order. GSTR-1 is filed state-wise, and a
  /// customer editing their address later must not rewrite past returns.
  placeOfSupply     String?
  courierId         Int?
  courierName       String?
  /// First time the order was seen delivered. The return window counts from
  /// here, so it is written once and never moved: couriers replay scans, and a
  /// second Delivered event must not hand out a fresh week to return in.
  deliveredAt       DateTime?
  /// When the money actually arrived. paymentStatus alone cannot say when, so
  /// without this any report of what the shop took last month has to guess from
  /// when the order was created. Written once, by whichever of the browser
  /// callback and the webhook wins the race.
  paidAt            DateTime?
  /// When we asked the customer to come back and finish. Recorded so we ask once
  /// and only once: a checkout nobody paid for is worth one reminder, and a
  /// second one is a shop that nags.
  recoveryEmailAt   DateTime?
  stockReleased     Boolean           @default(false)
  shippingAddress   Json?
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?
  razorpaySignature String?
  items             OrderItem[]
  shipment          Shipment?
  redemption        CouponRedemption?
  returns           ReturnRequest[]
  stockMoves        StockMove[]
  reviews           Review[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

/// A customer asking to send something back.
///
/// Separate from the order's own status because the two run on different clocks:
/// an order is Delivered and stays Delivered while a return against it is still
/// being decided. The order only becomes Returned once the goods are actually
/// back, which is what puts the stock on the shelf.
model ReturnRequest {
  id           String        @id @default(uuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Who asked. Null when the shop raised it on a guest's behalf.
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  reason       ReturnReason
  outcome      ReturnOutcome
  status       ReturnStatus  @default(REQUESTED)
  /// The customer's own words. Required: "damaged" alone cannot be judged.
  customerNote String
  /// What the damage looks like. Public URLs in our own storage bucket, checked
  /// against it on the way in: what a browser sends is not evidence until we
  /// know we are the ones hosting it.
  photos       String[]      @default([])
  /// Why we approved or refused, shown to the customer.
  adminNote    String?
  /// What this request was worth when it was decided, apportioned from what was
  /// actually paid. Frozen at approval so a later price change cannot move it.
  refundAmount Decimal?      @db.Decimal(10, 2)
  /// Razorpay's id for the money going back, and the proof it went. Unique, so
  /// the database itself refuses to record a second refund against one return
  /// even if every check above it were somehow skipped.
  refundId     String?       @unique
  refundedAt   DateTime?
  /// What Razorpay last said: pending, processed or failed. A refund is not
  /// finished when the call returns, only accepted.
  refundStatus String?
  /// Why the last attempt did not work, kept so the next person can see what
  /// happened without going through the logs.
  refundError  String?
  items        ReturnItem[]
  decidedAt    DateTime?
  receivedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([orderId])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  /// Decided when the parcel is opened. A soaked dress goes back to nobody, so
  /// restocking is a choice rather than something a status change assumes.
  resellable      Boolean?

  @@unique([returnRequestId, orderItemId])
}

model Shipment {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String    @default("shiprocket")
  providerOrderId    String?
  providerShipmentId String?
  providerReference  String?
  awb                String?
  courierId          Int?
  courierName        String?
  labelUrl           String?
  invoiceUrl         String?
  manifestUrl        String?
  trackingUrl        String?
  status             String?
  statusCode         Int?
  appliedWeightKg    Decimal?  @db.Decimal(6, 3)
  pickupScheduledAt  DateTime?
  pickupToken        String?
  events             Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([awb])
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  /// Snapshot of the size, for the same reason as gstRate below: a size that is
  /// renamed or withdrawn must not rewrite an invoice that has already gone out.
  variantLabel  String?
  /// Snapshot of the colour, for the same reason. Kept apart from the label so a
  /// picking list can print "Midnight blue · M" in its own columns rather than
  /// unpicking one string.
  variantColour String?
  quantity      Int
  price         Decimal         @db.Decimal(10, 2)
  /// Snapshot of the rate when the order was placed. Slabs change, and a
  /// reissued invoice has to match the one the customer already has.
  gstRate       Decimal         @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(10, 2)
  /// What the goods cost us at the time of sale. Snapshotted for the same
  /// reason as the rate: renegotiating with a supplier must not quietly
  /// rewrite the profit on orders that already shipped.
  costPrice     Decimal?        @db.Decimal(10, 2)
  returnItems   ReturnItem[]
  createdAt     DateTime        @default(now())

  @@index([variantId])
}

model Coupon {
  id             String     @id @default(uuid())
  /// Always stored upper case; lookups upper-case the input to match.
  code           String     @unique
  description    String?
  type           CouponType
  /// Percent off for PERCENT, rupees off for FLAT, unused for FREE_SHIPPING.
  value          Decimal    @default(0) @db.Decimal(10, 2)
  /// Ceiling on a percent discount, so "25% off up to ₹500" is expressible.
  maxDiscount    Decimal?   @db.Decimal(10, 2)
  /// Checked against the eligible lines only, not the whole bag.
  minOrderValue  Decimal    @default(0) @db.Decimal(10, 2)
  /// Redemptions allowed in total, and per customer. Null means no limit.
  usageLimit     Int?
  perUserLimit   Int?       @default(1)
  usageCount     Int        @default(0)
  /// Only redeemable by someone who has never had an order confirmed.
  firstOrderOnly Boolean    @default(false)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  /// Leave both empty for a coupon that applies to the whole catalogue. With
  /// either set, only matching lines are discounted.
  categories  CouponCategory[]
  products    CouponProduct[]
  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

/// Written when an order is confirmed, never when it is merely placed, so an
/// abandoned checkout does not burn a use of a limited code.
model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Kept so a guest checkout still counts against a per-customer limit.
  email     String?
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, email])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  /// The delivered order that earned the right to write this. Every review has
  /// one, because nobody can review something they were not sent. Kept so the
  /// claim can be checked later, and set to null rather than deleting the review
  /// if that order is ever removed.
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Set when the shop takes a review down. Abuse only: a shop that hides
  /// unflattering reviews is publishing an average it has rigged, which is both
  /// dishonest and against Google's rules for showing stars in search results.
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([productId, hiddenAt])
}
