generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
  FREE_SHIPPING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses   Address[]
  carts       Cart[]
  orders      Order[]
  reviews     Review[]
  wishlist    WishlistItem[]
  redemptions CouponRedemption[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String?
  country   String   @default("US")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  coupons     CouponCategory[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  images       String[]
  isActive     Boolean  @default(true)
  weightKg     Decimal  @default(0.5) @db.Decimal(6, 3)
  lengthCm     Int      @default(15)
  breadthCm    Int      @default(12)
  heightCm     Int      @default(6)
  hsn          String?
  /// GST percent. Price is the MRP, so this says how much tax is already inside it.
  gstRate      Decimal  @default(5) @db.Decimal(5, 2)
  /// What this costs to buy in, net of GST, since input tax credit means the
  /// tax paid to a supplier is not really a cost. Never leaves the API to
  /// anyone but an admin: see serializeProduct.
  costPrice    Decimal? @db.Decimal(10, 2)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlisted WishlistItem[]
  coupons    CouponProduct[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id                String        @id @default(uuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  email             String?
  customerName      String?
  customerPhone     String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  itemsTotal        Decimal       @default(0) @db.Decimal(10, 2)
  shippingAmount    Decimal       @default(0) @db.Decimal(10, 2)
  /// totalAmount is itemsTotal - discountTotal + shippingAmount.
  discountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  /// Snapshot, so a renamed or deleted code still reads correctly on the order.
  couponCode        String?
  totalAmount       Decimal       @db.Decimal(10, 2)
  /// GST already inside totalAmount, broken out for the invoice. Prices are
  /// tax-inclusive, so these never add to what the customer was charged.
  taxTotal          Decimal       @default(0) @db.Decimal(10, 2)
  cgstTotal         Decimal       @default(0) @db.Decimal(10, 2)
  sgstTotal         Decimal       @default(0) @db.Decimal(10, 2)
  igstTotal         Decimal       @default(0) @db.Decimal(10, 2)
  /// Buyer's state at the time of the order. GSTR-1 is filed state-wise, and a
  /// customer editing their address later must not rewrite past returns.
  placeOfSupply     String?
  courierId         Int?
  courierName       String?
  stockReleased     Boolean       @default(false)
  shippingAddress   Json?
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpaySignature String?
  items             OrderItem[]
  shipment          Shipment?
  redemption        CouponRedemption?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Shipment {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String    @default("shiprocket")
  providerOrderId    String?
  providerShipmentId String?
  providerReference  String?
  awb                String?
  courierId          Int?
  courierName        String?
  labelUrl           String?
  invoiceUrl         String?
  manifestUrl        String?
  trackingUrl        String?
  status             String?
  statusCode         Int?
  appliedWeightKg    Decimal?  @db.Decimal(6, 3)
  pickupScheduledAt  DateTime?
  pickupToken        String?
  events             Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([awb])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  /// Snapshot of the rate when the order was placed. Slabs change, and a
  /// reissued invoice has to match the one the customer already has.
  gstRate       Decimal @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal @default(0) @db.Decimal(10, 2)
  /// What the goods cost us at the time of sale. Snapshotted for the same
  /// reason as the rate: renegotiating with a supplier must not quietly
  /// rewrite the profit on orders that already shipped.
  costPrice     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Coupon {
  id          String     @id @default(uuid())
  /// Always stored upper case; lookups upper-case the input to match.
  code        String     @unique
  description String?
  type        CouponType
  /// Percent off for PERCENT, rupees off for FLAT, unused for FREE_SHIPPING.
  value       Decimal    @default(0) @db.Decimal(10, 2)
  /// Ceiling on a percent discount, so "25% off up to ₹500" is expressible.
  maxDiscount Decimal?   @db.Decimal(10, 2)
  /// Checked against the eligible lines only, not the whole bag.
  minOrderValue Decimal  @default(0) @db.Decimal(10, 2)
  /// Redemptions allowed in total, and per customer. Null means no limit.
  usageLimit   Int?
  perUserLimit Int?      @default(1)
  usageCount   Int       @default(0)
  /// Only redeemable by someone who has never had an order confirmed.
  firstOrderOnly Boolean @default(false)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Leave both empty for a coupon that applies to the whole catalogue. With
  /// either set, only matching lines are discounted.
  categories  CouponCategory[]
  products    CouponProduct[]
  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

/// Written when an order is confirmed, never when it is merely placed, so an
/// abandoned checkout does not burn a use of a limited code.
model CouponRedemption {
  id       String  @id @default(uuid())
  couponId String
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId  String  @unique
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Kept so a guest checkout still counts against a per-customer limit.
  email    String?
  amount   Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, email])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}
