PORT=5000

# Supabase PostgreSQL connection string
# Use the connection pooler URL for serverless/edge environments:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/shukarsh?schema=public"

JWT_SECRET="your-super-secret-jwt-key-change-this"
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
# Dashboard -> Settings -> Webhooks. Without this a payment captured after the
# customer closes the tab never marks the order paid.
RAZORPAY_WEBHOOK_SECRET="..."
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Transactional email (order confirmation and dispatch notice).
# Leave blank to skip sending; nothing else changes.
RESEND_API_KEY="re_..."
EMAIL_FROM="Shukarsh <orders@yourdomain.com>"
EMAIL_REPLY_TO="hello@yourdomain.com"

# Failed sign ins and new accounts allowed per IP per 15 minutes.
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_REGISTER_MAX="5"

# Automatic order progress. The Shiprocket webhook already pushes courier
# updates; this polls as a safety net for anything it misses.
# Minutes between in-process runs. Blank disables it, which is right on a host
# that sleeps between requests. Use an external scheduler there instead.
TRACKING_SYNC_INTERVAL_MIN=""
# Lets a scheduler POST /api/logistics/sync with an x-cron-key header.
CRON_SECRET=""
# Cooldown, in seconds, for syncs a person triggers: opening the orders panel or
# pressing Refresh tracking. Inside the window those answer "already up to date"
# without calling the courier. Blank uses 300. Schedulers ignore this.
TRACKING_SYNC_MIN_GAP_SEC=""

# Supabase Storage (product image uploads)
# Project Settings -> API. The service role key must stay server-side only.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
SUPABASE_BUCKET="product-images"

# Shiprocket (shipping rates, labels, tracking)
# Create an API user under Settings -> API -> Configure. These are NOT your
# dashboard login details. Leave blank to run the store with free shipping.
SHIPROCKET_EMAIL="api-user@example.com"
SHIPROCKET_PASSWORD="..."
# Must match a pickup nickname from Settings -> Pickup Addresses exactly.
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE="110001"
# Optional: channel id from Settings -> Channels, defaults to the custom channel.
SHIPROCKET_CHANNEL_ID=""
# Shared secret for the status webhook, sent by Shiprocket as the x-api-key header.
SHIPROCKET_WEBHOOK_TOKEN="generate-a-long-random-string"
# Optional tuning.
SHIPROCKET_API_BASE_URL="https://apiv2.shiprocket.in"
SHIPROCKET_REQUEST_TIMEOUT_MS="15000"
SHIPROCKET_RATE_CACHE_TTL_SEC="900"
