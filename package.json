{
  "name": "shukarsh-backend",
  "version": "1.0.0",
  "description": "Backend API for Shukarsh e-commerce store",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "prestart": "prisma migrate deploy",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "check:tax": "ts-node scripts/check-tax.ts",
    "rates:survey": "ts-node scripts/shipping-rates.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "razorpay": "^2.9.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0"
  }
}
